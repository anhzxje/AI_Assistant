OMNI_ENV=local
OMNI_LOG_LEVEL=INFO

# Data roots
OMNI_PROJECT_ROOT=.
OMNI_DATA_ROOT=data
OMNI_SEED_SOURCES_PATH=../Agent_Knowledge_Base/crawl/seed_sources.txt

# Crawl policy
OMNI_ALLOWED_DOMAINS=["hus.vnu.edu.vn","tuyensinh.hus.vnu.edu.vn"]
OMNI_CRAWL_MAX_DEPTH=2
OMNI_CRAWL_TIMEOUT_SECONDS=20
OMNI_CRAWL_MAX_RETRIES=3
OMNI_CRAWL_USER_AGENT=OmniAssistantDataCrawler/0.1 (+local academic project)
OMNI_RESPECT_ROBOTS_TXT=true

# Local platform services; used by later ingestion/storage steps.
POSTGRES_DSN=postgresql://omni:omni@127.0.0.1:5432/omni_assistant
REDIS_URL=redis://127.0.0.1:6379/0

# Embeddings / vector retrieval
OMNI_QDRANT_URL=http://127.0.0.1:6333
OMNI_QDRANT_LOCAL_PATH=data/features/qdrant_local
OMNI_QDRANT_MEMORY_LOCAL_PATH=data/features/qdrant_memory_local
OMNI_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
OMNI_EMBEDDING_FALLBACK_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OMNI_EMBEDDING_DEVICE=auto
OMNI_QDRANT_COLLECTION=omni_hus_chunks

# Local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OMNI_FORCE_LLM=true
OMNI_LLM_TIMEOUT_SEC=20
OMNI_LLM_FAST_MODE=true

# Voice layer
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=vi
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
OMNI_VOICE_FAST_MODE=true
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Google login uses only OpenID identity scopes: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/calendar/callback
FRONTEND_URL=http://127.0.0.1:3002
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Future Google connector OAuth. Keep credential files outside git.
GOOGLE_CLIENT_SECRET_PATH=
